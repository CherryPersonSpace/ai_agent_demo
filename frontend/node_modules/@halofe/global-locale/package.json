{
  "name": "@halofe/global-locale",
  "version": "1.0.3",
  "description": "locale information manager",
  "main": "lib/index.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "build": "npm run build:types && npm run build:js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:types:watch": "tsc --emitDeclarationOnly -w",
    "build:js": "babel src --out-dir lib --extensions \".ts,.tsx\" --source-maps ",
    "build:js:watch": "babel src --out-dir lib --extensions \".ts,.tsx\" --source-maps --watch",
    "eslint": "git diff-index --name-only HEAD | grep -E \"(.*\\/)?src\\/(.*)\\.(jsx|js|ts|tsx)$\" | xargs node_modules/eslint/bin/eslint.js -c .eslintrc.js",
    "webpack": "concurrently npm:build:types:watch npm:build:js:watch \"node_modules/.bin/webpack-dev-server --config script/compatibility-test/webpack.js\"",
    "test": "node script/compatibility-test/index",
    "electron-test": "concurrently \"node_modules/.bin/http-server ./\" \"node_modules/.bin/electron script/electron-test/main.js\"",
    "start": "concurrently npm:build:types:watch npm:build:js:watch npm:electron-test",
    "prepublish": "npm run  build"
  },
  "files": [
    "lib"
  ],
  "license": "ISC",
  "devDependencies": {
    "@ali/fie4-plugin-halo-component": "^1.3.0-alpha.11",
    "@babel/cli": "^7.4.4",
    "@babel/core": "^7.4.4",
    "@babel/plugin-proposal-class-properties": "^7.4.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.4.4",
    "@babel/preset-env": "^7.4.4",
    "@babel/preset-typescript": "^7.3.3",
    "@types/node": "^11.13.8",
    "@typescript-eslint/eslint-plugin": "^1.7.0",
    "@typescript-eslint/parser": "^1.7.0",
    "babel-eslint": "^10.0.1",
    "chai": "^4.2.0",
    "concurrently": "^4.1.0",
    "core-js-compat": "^3.0.1",
    "electron": "^5.0.1",
    "eslint": "^5.16.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.2.0",
    "eslint-plugin-babel": "^5.3.0",
    "eslint-plugin-import": "^2.17.2",
    "eslint-plugin-jest": "^22.5.1",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-markdown": "^1.0.0",
    "eslint-plugin-react": "^7.13.0",
    "eslint-tinker": "^0.5.0",
    "find": "^0.3.0",
    "html-webpack-plugin": "^3.2.0",
    "http-server": "^0.11.1",
    "karma": "^4.1.0",
    "karma-chrome-launcher": "^2.2.0",
    "karma-coverage": "^1.1.2",
    "karma-mocha": "^1.3.0",
    "karma-sourcemap-loader": "^0.3.7",
    "karma-webdriver-launcher": "^1.0.5",
    "karma-webpack": "^3.0.5",
    "minimist": "^1.2.0",
    "mocha": "^6.1.4",
    "mocha-loader": "^2.0.1",
    "power-assert": "^1.6.1",
    "pre-commit": "^1.2.2",
    "typescript": "^3.4.5",
    "webpack": "^4.30.0",
    "webpack-cli": "^3.3.2",
    "webpack-dashboard": "^3.0.5",
    "webpack-dev-server": "^3.3.1"
  },
  "browserslist": "ie 10",
  "pre-commit": [
    "eslint"
  ],
  "alphaVersion": "1.0.3-alpha.3"
}