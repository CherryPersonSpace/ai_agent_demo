{
  "name": "@halofe/global-string-format",
  "version": "1.0.8",
  "description": "",
  "main": "lib/index.js",
  "scripts": {
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "build": "npm run build:types && npm run build:js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:types:watch": "tsc --emitDeclarationOnly -w",
    "build:js": "babel src --out-dir lib --extensions \".ts,.tsx\" --source-maps ",
    "build:js:watch": "babel src --out-dir lib --extensions \".ts,.tsx\" --source-maps --watch",
    "eslint": "git diff-index --name-only HEAD | grep -E \"(.*\\/)?src\\/(.*)\\.(jsx|js|ts|tsx)$\" | xargs node_modules/eslint/bin/eslint.js -c .eslintrc.js",
    "webpack": "concurrently npm:build:types:watch npm:build:js:watch \"node_modules/.bin/webpack-dev-server --config example/react-element/webpack.js\"",
    "test": "mocha",
    "start": "concurrently npm:build:types:watch npm:build:js:watch"
  },
  "files": [
    "lib"
  ],
  "license": "ISC",
  "devDependencies": {
    "@ali/fie4-plugin-halo-component": "^1.3.0-alpha.11",
    "@babel/cli": "^7.4.4",
    "@babel/core": "^7.4.5",
    "@babel/plugin-proposal-class-properties": "^7.4.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.4.4",
    "@babel/preset-env": "^7.4.5",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.3.3",
    "@types/node": "^11.13.8",
    "@typescript-eslint/eslint-plugin": "^2.1.0",
    "@typescript-eslint/parser": "^2.1.0",
    "babel-eslint": "^10.0.1",
    "babel-loader": "^8.0.6",
    "chai": "^4.2.0",
    "concurrently": "^4.1.0",
    "core-js-compat": "^3.0.1",
    "electron": "^5.0.1",
    "eslint": "^5.16.0",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-config-prettier": "^4.2.0",
    "eslint-plugin-babel": "^5.3.0",
    "eslint-plugin-import": "^2.17.2",
    "eslint-plugin-jest": "^22.5.1",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-markdown": "^1.0.0",
    "eslint-plugin-react": "^7.13.0",
    "eslint-tinker": "^0.5.0",
    "expect": "^24.8.0",
    "find": "^0.3.0",
    "html-webpack-plugin": "^3.2.0",
    "http-server": "^0.11.1",
    "minimist": "^1.2.0",
    "mocha": "^6.1.4",
    "mocha-loader": "^2.0.1",
    "power-assert": "^1.6.1",
    "pre-commit": "^1.2.2",
    "typescript": "^3.4.5",
    "webpack": "^4.35.2",
    "webpack-cli": "^3.3.5",
    "webpack-dev-server": "^3.7.2"
  },
  "browserslist": "ie 10",
  "pre-commit": [
    "eslint"
  ],
  "dependencies": {
    "intl-messageformat": "^2.2.0",
    "universal-env": "^1.0.1"
  },
  "alphaVersion": "1.0.8-alpha.4"
}